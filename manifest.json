{
  "schemaVersion": 1,
  "id": "tmn73.calendar",
  "name": "Calendar",
  "version": "0.5.0",
  "author": "tmn73",
  "license": "MIT",
  "description": "Your Google Calendar in the bar. Your day at a glance, one click to join a meeting, and events you create and edit without leaving the desktop.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Calendar",
    "description": "Your Google Calendar in the bar. Your day at a glance, one click to join a meeting, and events you create and edit without leaving the desktop.",
    "category": "Time",
    "allowMultiple": false,
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "HH\n-\nmm",
      "eventTimeFormat": "HH:mm",
      "language": "auto",
      "reminders": true,
      "announceLeadMinutes": 15
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Date format",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format",
        "defaultValue": "d MMMM 'W'ww yyyy"
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "Vertical bar format",
        "defaultValue": "HH\n-\nmm"
      },
      {
        "key": "eventTimeFormat",
        "type": "string",
        "label": "Event time format",
        "defaultValue": "HH:mm"
      },
      {
        "key": "language",
        "type": "enum",
        "label": "Language",
        "options": [
          "auto",
          "en",
          "pt"
        ],
        "defaultValue": "auto",
        "description": "auto follows the system locale (Portuguese for pt_*, otherwise English)."
      },
      {
        "key": "reminders",
        "type": "boolean",
        "label": "Desktop reminders",
        "defaultValue": true,
        "description": "Notify at each event's reminder times; meetings with a link get one 10 minutes before."
      },
      {
        "key": "announceLeadMinutes",
        "type": "number",
        "label": "Announce events (minutes before)",
        "min": 0,
        "max": 120,
        "step": 5,
        "defaultValue": 15,
        "description": "Show the next event beside the clock this long before it starts. 0 keeps the clock alone."
      },
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "defaultValue": 0
      },
      {
        "key": "lifeExpectancy",
        "type": "number",
        "label": "Life expectancy",
        "defaultValue": 0
      }
    ]
  }
}
